# Flask rig behavior. This file is documentation only; export values in the
# launcher environment because the application does not auto-load .env files.
PI_SSH_USER=pi
CAMERA_BOOTSTRAP_ENABLED=1
FORCE_CUDA_RECORD=1
REQUIRE_CUDA_RECORD=1
# 1 forces the CPU path (software decode, libx264) even when the GPU works.
# Used for the CPU-only rows of docs/test-matrix.md. Overrides FORCE_CUDA_RECORD.
DISABLE_CUDA_RECORD=0
APP_USE_CASE=wide_angle
MIC_CAMERA_KEY=
# Camera capture size handed to v4l2rtspserver -W/-H on every Pi (test/low-res).
# Must be an MJPEG mode the sensor lists at 90 fps. See docs/lowres-benchmark.md.
RIG_CAPTURE_RES=1280x720

# Separate heartbeat sidecar
HEARTBEAT_SERVICE_URL=http://127.0.0.1:8000
# HEARTBEAT_SESSIONS_DIR=/absolute/path/to/heartbeat-sessions
HEARTBEAT_TIMEOUT_SECONDS=0.8
HEARTBEAT_AUTOSTART=1
# HEARTBEAT_PROJECT_DIR=/absolute/path/to/heartbeat
# HEARTBEAT_PYTHON=/absolute/path/to/heartbeat/.venv/bin/python
HEARTBEAT_PORT=8000
# HEARTBEAT_DEVICE=

# Focus thresholds
FOCUS_PEAK_RATIO=0.97
FOCUS_NEAR_RATIO=0.85

# Direct upload to the Forgeon cloud (docs/direct-upload-design.md §3).
# Token: minted once by an admin via POST /rig/devices (or tools/rig_upload_test.py
# --register); the worker attaches it to every call — no per-upload auth ever.
# Both unset -> upload routes answer 503; everything else unchanged.
FORGEON_API_URL=https://api-dev-new.forgelabs.in/dev
FORGEON_DEVICE_TOKEN=
